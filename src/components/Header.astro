---
import { useTranslations, localise, type Lang } from "../i18n/ui";
import ThemeToggle from "./ThemeToggle.astro";

interface Props { lang: Lang; altPath?: string }
const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "en" ? "pt" : "en";

// Falls back to the other language's home when this page has no translation.
const switchTo = altPath ?? localise(other, "/");
---

<header class="site-head">
  <div class="bar">
    <a class="brand" href={localise(lang, "/")}>vinicius</a>

    <nav class="links" aria-label="Main">
      <a href={localise(lang, "/about")}>{t("nav.about")}</a>

      <a class="icon" href="https://github.com/vinicius-cardoso"
         rel="me noopener" target="_blank" aria-label={t("nav.github")}>
        <!-- GitHub mark, inline so it needs no request and inherits currentColor -->
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                   0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                   -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                   .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                   -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09
                   2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82
                   2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01
                   2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>

      <a class="lang" href={switchTo} lang={other === "pt" ? "pt-BR" : "en"}>
        {lang === "en" ? "PT" : "EN"}
      </a>

      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>

<style>
  .site-head {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    max-width: var(--page);
    margin: 0 auto;
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-md);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    font-size: var(--t-sm);
  }
  .links a {
    color: var(--ink-2);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .links a:hover { color: var(--accent); }
  .lang {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0.25rem 0.5rem;
  }
  .lang:hover { border-color: var(--accent); }

  @media (max-width: 30rem) {
    .bar { gap: var(--sp-3); padding-inline: var(--sp-4); }
    .links { gap: var(--sp-4); }
  }
</style>
