---
import { getCollection, getEntry, render } from "astro:content";
import ArticleLayout from "../../layouts/Article.astro";
import { readingTime, partsOf, translationOf, bareId } from "../../lib/content";
import { localise } from "../../i18n/ui";

export async function getStaticPaths() {
  const all = await getCollection("articles", (e) => import.meta.env.DEV || !e.data.draft);
  return all
    .filter((a) => a.data.lang === "en")
    .map((article) => ({
      params: { slug: bareId(article.id) },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const minutes = readingTime(article.body ?? "");

const series = article.data.series
  ? await getEntry("series", `en/${article.data.series}`)
  : undefined;
const parts = article.data.series ? await partsOf(article.data.series, "en") : undefined;

const twin = await translationOf(article, "pt");
const altPath = twin ? localise("pt", `/blog/${bareId(twin.id)}`) : undefined;
---

<ArticleLayout article={article} lang="en" minutes={minutes} altPath={altPath}
               series={series} parts={parts}>
  <Content />
</ArticleLayout>
