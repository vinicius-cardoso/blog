---
import Base from "../layouts/Base.astro";
---
<Base title="About — Vinícius Cardoso"
      description="A bit about me and what I write here."
      lang="en" altPath="/pt/sobre">
  <div class="wrap prose">
    <h1>About</h1>
    <p>
      I'm Vinícius. I build things, break them, and write down what happened —
      mostly self-hosted infrastructure and small tools.
    </p>
    <p>
      This blog is also deliberate English practice, so the writing is part of
      the point rather than a wrapper around it. You can read every article in
      Portuguese too, using the switch in the header.
    </p>
    <p>
      Code for most of what I write about lives on
      <a href="https://github.com/vinicius-cardoso" rel="me">GitHub</a>,
      including <a href="https://github.com/vinicius-cardoso/blog">this site</a>.
    </p>
  </div>
</Base>
