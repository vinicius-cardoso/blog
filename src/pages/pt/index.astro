---
import Base from "../../layouts/Base.astro";
import ArticleList from "../../components/ArticleList.astro";
---

<Base
  title="Vinícius Cardoso"
  description="Projetos pessoais, coisas que construí e o que aprendi no caminho."
  lang="pt"
  altPath="/"
>
  <div class="wrap">
    <div class="intro prose">
      <h1>Escrita</h1>
      <p>
        Notas sobre as coisas que eu construo — principalmente infraestrutura
        self-hosted, ferramentas pequenas e o que quebrei aprendendo algo novo.
      </p>
    </div>
    <ArticleList lang="pt" />
  </div>
</Base>

<style>
  .intro { margin-bottom: var(--sp-6); }
  .intro p { color: var(--ink-2); font-size: var(--t-md); }
</style>
