---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path of the equivalent page in the other language, if one exists. */
  altPath?: string;
}

const { title, description, lang, altPath } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost").toString();
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {altPath && (
      <link
        rel="alternate"
        hreflang={lang === "en" ? "pt-BR" : "en"}
        href={`${site}${altPath}`}
      />
    )}

    <link rel="alternate" type="application/rss+xml" title={title}
          href={lang === "pt" ? "/rss.pt.xml" : "/rss.xml"} />

    <!-- SVG first: modern browsers prefer it and it can adapt to the reader's
         theme. The .ico is the fallback for older browsers, which also request
         /favicon.ico directly whether or not it is declared here. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts are self-hosted from /public/fonts: no request ever leaves for
         Google, and the site keeps working if their CDN is unreachable. -->
    <link rel="preload" href="/fonts/public-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Runs before first paint so a dark-theme reader never sees a white
         flash. Deliberately inline and synchronous; it is only a few lines. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          /* private mode or storage disabled — fall through to the OS setting */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header lang={lang} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
