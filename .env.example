# Copy to .env and fill in. .env is gitignored — this repo is public, so the
# real values (password hash, session secret, host address) must never be
# committed.

# Public base URL of the site. Used for canonical links, RSS and sitemap.
SITE_URL="https://example.com"

# --- admin (see admin/README.md) ---

# Address the admin binds to. Bind to the Tailscale interface so the admin is
# unreachable from the public internet; 127.0.0.1 also works behind a tunnel.
ADMIN_BIND="100.x.y.z:8787"

# argon2id hash of your password. Generate with:  ./admin/bin/blogadmin hash
ADMIN_USER="vinicius"
ADMIN_PASSWORD_HASH=""

# Random 32+ byte string for signing session cookies.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# Where the admin writes Markdown, relative to the repo root.
CONTENT_DIR="src/content"
