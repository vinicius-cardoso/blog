# vinilabs.cc — blog. Caddy obtains and renews the certificate itself.
#
# Subdomains for other projects go in their own blocks below, each getting
# its own certificate automatically. See the commented example at the end.

vinilabs.cc, www.vinilabs.cc {
	root * /var/www/blog
	encode zstd gzip

	# Astro fingerprints asset filenames, so those can be cached hard.
	# HTML must not be, or readers get a stale page after a deploy.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /*.html Cache-Control "public, max-age=0, must-revalidate"
	header / Cache-Control "public, max-age=0, must-revalidate"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

# Example — a project on its own subdomain, proxied to a local port.
# Uncomment and adjust when you want box-hinge reachable by name:
#
# hinge.vinilabs.cc {
# 	reverse_proxy localhost:8000
# }
