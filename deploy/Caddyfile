# Template — copy to the server as /etc/caddy/Caddyfile and replace
# example.com with the real domain. The domain is deliberately not committed:
# this repo is public, and pairing a hostname with its exact stack is free
# reconnaissance.

example.com {
	root * /var/www/blog
	encode zstd gzip

	# Hashed asset filenames can be cached hard; HTML must not be, or readers
	# get a stale page after a deploy.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /*.html Cache-Control "public, max-age=0, must-revalidate"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	file_server
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

# The admin is NOT exposed here. It binds to the Tailscale interface only, so
# it is unreachable from the public internet by construction rather than by
# password. Reach it at http://<tailscale-ip>:8787 from a device on the tailnet.
